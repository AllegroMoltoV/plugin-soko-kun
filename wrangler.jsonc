{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plugin-soko-kun",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // global_fetch_strictly_public は CIMD 文書の取得で SSRF を防ぐために必須
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "vars": {
    "ORIGIN": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plugin-soko-kun",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth-kv" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  // /og.png と /logo.png を PNG のファイルのまま配信する。キャッシュとヘッダーは public/_headers で指定する。
  "assets": { "directory": "./public" },
  // テスト用の環境。Workers AI は実環境へつながるため定義せず、翻訳は行わない。
  "env": {
    // 本番の環境。binding は既定の環境から引き継がれないため、すべてここに書く。triggers と observability は引き継がれる。
    "production": {
      "vars": { "ORIGIN": "https://soko-kun.allegromoltov.jp" },
      "routes": [{ "pattern": "soko-kun.allegromoltov.jp", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "plugin-soko-kun",
          "database_id": "21df0ed2-9b7e-481b-94f0-414273af6fad",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "a730202391984d0a863ca4e22ea5d772" }]
    },
    "test": {
      "vars": { "ORIGIN": "http://localhost:8787" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "plugin-soko-kun",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth-kv" }]
    }
  }
}
